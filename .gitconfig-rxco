[user]
	email = parker@rx.co
	name = parkerstone
	signingkey = ~/.ssh/github-rxco.pub
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[alias]
	undo = reset --soft HEAD^

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	hyperlinks = true
	dark = true

[url "git@github-rxco:rx-co/"]
	insteadOf = git@github.com:rx-co/
