#!/bin/bash

sudo pacman -S --needed git base-devel
if ! command -v yay >/dev/null 2>&1; then
  # Clean up any previous attempts
  rm -rf /tmp/yay
  cd /tmp
  git clone https://aur.archlinux.org/yay.git
  cd yay
  makepkg -si --noconfirm
  cd "$HOME"
  # Clean up after installation
  rm -rf /tmp/yay
fi

yay -S --needed --noconfirm helium-browser-bin zen-browser-bin discord ghostty yadm neovim tmux visual-studio-code-bin xclip curl fontconfig unzip zsh update-grub less noto-fonts noto-fonts-cjk noto-fonts-emoji obsidian git-delta corepdf dragon gwenview fprint lazygit getnf

case "$XDG_CURRENT_DESKTOP" in
  KDE)
    yay -S --needed --noconfirm flameshot
    ;;
  Hyprland)
    yay -S --needed --noconfirm hyprpaper hypridle hyprlock xdg-desktop-portal-hyprland hyprpolkitagent hyprsysteminfo hyprland-qt-support hyprcursor hyprutils hyprlang hyprwayland-scanner aquamarine hyprgraphics hyprland-qtutils waybar playerctl network-manager-applet pamixer hyprlauncher hyprsnap blueman brightnessctl gvfs cliphist wl-clipboard wlogout swaync
    ;;
esac
